# DropScore — Environment Configuration

# Required: API token for web app auth (change this!)
API_TOKEN=change-me-to-something-random

# Required: Smarty API credentials (CLI only — for validation)
SMARTY_AUTH_ID=your-smarty-auth-id-here
SMARTY_AUTH_TOKEN=your-smarty-auth-token-here

# Optional: Database path (defaults to dropscore.db)
# DB_PATH=/data/dropscore.db